# Optional, non-secret Docker Compose settings. Defaults use persistent volumes.
# See llms.txt / DOCS/storage.md before choosing or changing a disk.
APP_PORT=43729
BIND_ADDRESS=0.0.0.0
TZ=UTC
STORAGE_LABEL=Media storage

# To put downloads on another disk, uncomment and use an absolute path.
# Prepare the directory for container UID/GID 1000 before starting.
# DOWNLOAD_PATH=/absolute/path/to/downloads
# Confirm the actual disk/share is mounted; an existing folder is not proof.
# Plan around 20 GB free for initial media, plus Docker build disk capacity.

# NFS and existing-server deployments: see README before changing volume options.
# REQUIRE_NFS=true
# DOWNLOAD_MOUNT_OPTIONS=rw,nocopy
# MEDIA_VOLUME_NAME=f1tv-dl-media
# STORAGE_ID=f1tv-dl-media-v1

# Native development only (not needed by Docker Compose):
# DATA_DIR=./data
# DOWNLOAD_DIR=./downloads
DOWNLOAD_INACTIVITY_TIMEOUT_MS=300000
# Admission floor only, not a replay-size estimate or reservation; do not lower
# it to conceal insufficient disk space. 200 MB cannot start a replay.
STORAGE_MIN_FREE_BYTES=2000000000
