{
  "name": "f1tv-dl-webui",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted F1 TV replay downloads for offline viewing",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-f1tv-dl.mjs",
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 43730",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run licenses && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/index.js",
    "licenses": "node scripts/prepare-notices.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@thedave42/f1tv-dl": "0.25.18-alpha.0",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.5",
    "lucide-react": "1.76.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.9"
  },
  "overrides": {
    "@thedave42/fluent-ffmpeg": "npm:fluent-ffmpeg@2.1.3",
    "axios": "1.20.0",
    "@xmldom/xmldom": "0.9.12",
    "extract-zip": "2.0.1",
    "mpd-parser": "1.4.0",
    "puppeteer": "25.13.0",
    "tar-fs": "3.1.3",
    "ws": "8.22.0"
  }
}
