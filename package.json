{
  "name": "f1tv-dl-webui",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted tablet-friendly web UI for f1tv-dl",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 43730",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@thedave42/f1tv-dl": "0.25.18-alpha.0",
    "better-sqlite3": "12.4.1",
    "fastify": "5.6.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.9"
  },
  "overrides": {
    "@thedave42/fluent-ffmpeg": "npm:fluent-ffmpeg@2.1.3"
  }
}
